---
import { type Lang } from '../i18n/ui';
import NewsletterForm from '../components/NewsletterForm.astro';
import { listIssues } from '../lib/beehiiv';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';

// Published issues come live from beehiiv. They are written in German, so the
// English page lists them too (linking to the German pages) and says so.
const issues = await listIssues();
const dateFmt = new Intl.DateTimeFormat(de ? 'de-DE' : 'en-GB', { dateStyle: 'long' });
---

<div class="container-page py-16 lg:py-20">
  <div class="max-w-2xl">
    <p class="eyebrow">Newsletter</p>
    <h1 class="text-4xl sm:text-5xl font-bold">
      {de ? 'Einmal pro Woche Post von uns' : 'A letter from us, once a week'}
    </h1>
    <p class="mt-5 text-lg text-muted">
      {de
        ? 'In unserem Newsletter erzählen wir dir ehrlich und persönlich, was in unserer Arbeit für die Ärmsten im Sudan und in Afrika passiert: wo Hilfe ankommt, welche Menschen hinter den Zahlen stehen und wie du Teil davon sein kannst.'
        : 'In our newsletter we tell you, honestly and personally, what is happening in our work for the poorest people in Sudan and across Africa: where help arrives, who the people behind the numbers are, and how you can be part of it.'}
    </p>
    <p class="mt-4 text-lg text-muted">
      {de
        ? 'Kein Spam, keine Weitergabe deiner Daten – und abmelden kannst du dich jederzeit mit einem Klick.'
        : 'No spam, no sharing of your data – and you can unsubscribe at any time with one click.'}
    </p>
  </div>

  <div class="mt-10">
    <NewsletterForm lang={lang} />
  </div>

  <section class="mt-16 lg:mt-20" aria-labelledby="nl-archive">
    <h2 id="nl-archive" class="text-3xl sm:text-4xl font-bold">
      {de ? 'Ausgaben' : 'Issues'}
    </h2>
    {!de && issues.length > 0 && (
      <p class="mt-3 text-muted">Our newsletter is currently written in German.</p>
    )}

    {
      issues.length === 0 ? (
        <p class="mt-6 text-muted">
          {de
            ? 'Die erste Ausgabe erscheint in Kürze. Melde dich an, dann bekommst du sie direkt in dein Postfach.'
            : 'The first issue is coming soon. Sign up and it will land straight in your inbox.'}
        </p>
      ) : (
        <ul class="mt-8 grid gap-5 sm:grid-cols-2">
          {issues.map((issue) => {
            const href = `/newsletter/${encodeURIComponent(issue.slug)}`;
            return (
              <li>
                <article class="card h-full overflow-hidden flex flex-col">
                  {issue.image && (
                    <a href={href} tabindex="-1" aria-hidden="true">
                      <img src={issue.image} alt="" loading="lazy" class="w-full aspect-[1200/630] object-cover" />
                    </a>
                  )}
                  <div class="p-6 flex flex-col flex-1">
                    <time datetime={issue.date.toISOString()} class="text-sm font-semibold text-muted">
                      {dateFmt.format(issue.date)}
                    </time>
                    <h3 class="mt-1.5 font-display text-xl font-bold">
                      <a href={href} class="hover:text-gold-700">{issue.title}</a>
                    </h3>
                    {issue.summary && <p class="mt-2 text-muted flex-1">{issue.summary}</p>}
                    <a href={href} class="mt-4 font-semibold text-gold-700 hover:underline">
                      {de ? 'Lesen' : 'Read'} →
                    </a>
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</div>
