---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';
---

<div class="container-page py-16 lg:py-20">
  <article class="prose-page">
    <p class="eyebrow">{de ? 'Kontakt' : 'Contact'}</p>
    <h1 class="text-4xl sm:text-5xl font-bold mb-6">{de ? 'Kontakt' : 'Contact'}</h1>
    {
      de ? (
        <>
          <p><strong>Platzhalter.</strong> E-Mail-Adresse, ggf. Postanschrift und Telefonzeiten.</p>
          <p>E-Mail: <a href="mailto:info@your-domain.org">info@your-domain.org</a></p>
          <p>Für Mitgliedschaftsanfragen nutze bitte das Formular unter „Mitglied werden“.</p>
        </>
      ) : (
        <>
          <p><strong>Placeholder.</strong> Email address, postal address if any, phone hours.</p>
          <p>Email: <a href="mailto:info@your-domain.org">info@your-domain.org</a></p>
          <p>For membership requests, please use the form under "Become a member".</p>
        </>
      )
    }
  </article>
</div>
