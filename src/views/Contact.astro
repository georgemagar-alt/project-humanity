---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<article class="prose">
  <h1>{lang === 'de' ? 'Kontakt' : 'Contact'}</h1>
  {
    lang === 'de' ? (
      <>
        <p>
          <strong>Platzhalter.</strong> E-Mail-Adresse, ggf. Postanschrift und Telefonzeiten.
        </p>
        <p>
          E-Mail: <a href="mailto:info@your-domain.org">info@your-domain.org</a>
        </p>
        <p>
          Für Mitgliedschaftsanfragen nutze bitte das Formular unter „Mitglied werden“.
        </p>
      </>
    ) : (
      <>
        <p>
          <strong>Placeholder.</strong> Email address, postal address if any, phone hours.
        </p>
        <p>
          Email: <a href="mailto:info@your-domain.org">info@your-domain.org</a>
        </p>
        <p>For membership requests, please use the form under "Become a member".</p>
      </>
    )
  }
</article>
