---
import { Image } from 'astro:assets';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { getPublicCampaigns, type CampaignPublic } from '../lib/db';
import { formatCents } from '../lib/money';
import CampaignList from '../components/CampaignList.astro';
import heroImg from '../assets/images/hero.jpg';
import motherChild from '../assets/images/mother-child.jpg';
import sudanSlums from '../assets/images/sudan-slums.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const de = lang === 'de';

let campaigns: CampaignPublic[] = [];
try {
  campaigns = await getPublicCampaigns();
} catch {
  campaigns = [];
}
const active = campaigns.filter((c) => c.status === 'active');
const totalRaised = active.reduce((s, c) => s + c.raisedCents, 0);

const stats = [
  { value: '33,7 Mio.', label: de ? 'Menschen im Sudan brauchen 2026 Hilfe' : 'people in Sudan need aid in 2026' },
  { value: de ? '1 von 4' : '1 in 4', label: de ? 'Menschen im Sudan ist auf der Flucht' : 'people in Sudan is displaced' },
  { value: '100 %', label: de ? 'jeder Spende fließt in die Projekte' : 'of every donation goes to the projects' },
];
---

<!-- Hero -->
<section class="relative isolate overflow-clip bg-ink text-white">
  <Image
    src={heroImg}
    alt=""
    widths={[640, 960, 1280, 1920, 2600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_42%]"
  />
  <!-- Scrim: the hero photo is high-key B&W, so a strong dark gradient keeps the
       white headline legible on every screen. Darkest at the bottom-left where the text sits. -->
  <div
    class="absolute inset-0 -z-10"
    style="background:linear-gradient(to top, rgba(20,17,12,.94) 0%, rgba(20,17,12,.82) 42%, rgba(20,17,12,.55) 100%), linear-gradient(to right, rgba(20,17,12,.8), rgba(20,17,12,.15) 65%)"
  >
  </div>
  <div class="container-page pt-24 pb-16 sm:pt-28 sm:pb-20 lg:pt-40 lg:pb-28 max-w-3xl">
    <p class="eyebrow text-gold">{t('site.name')}</p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white [text-shadow:0_2px_20px_rgba(0,0,0,.35)]">
      {de
        ? 'Konkrete Hilfe für die Ärmsten in den Slums Afrikas.'
        : 'Concrete help for the poorest people in the slums of Africa.'}
    </h1>
    <p class="mt-6 text-lg sm:text-xl text-white/90 max-w-2xl">
      {de
        ? 'Project Humanity e.V. bringt Nahrung, Kleidung, Schulmaterial und medizinische Versorgung dorthin, wo sie am dringendsten gebraucht werden – unabhängig von Religion oder Herkunft.'
        : 'Project Humanity e.V. brings food, clothing, school supplies and healthcare to where they are needed most — regardless of religion or origin.'}
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a class="btn" href={localizePath('/spenden', lang)}>{t('nav.donate')}</a>
      <a class="btn btn-on-dark" href={localizePath('/mitglied-werden', lang)}>{t('nav.join')}</a>
    </div>
  </div>
</section>

<!-- Stat band -->
<section class="bg-gold text-ink">
  <div class="container-page py-12 grid gap-8 sm:grid-cols-3 text-center sm:text-left">
    {stats.map((s) => (
      <div>
        <div class="font-display text-4xl sm:text-5xl font-bold leading-none">{s.value}</div>
        <p class="mt-2 text-sm font-medium text-ink/80">{s.label}</p>
      </div>
    ))}
  </div>
</section>

<!-- Campaigns -->
<section class="container-page py-20 lg:py-24">
  <p class="eyebrow">{de ? 'Jede Spende zählt' : 'Every donation counts'}</p>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="text-3xl sm:text-4xl font-bold">{de ? 'Aktuelle Kampagnen' : 'Current campaigns'}</h2>
    {active.length > 0 && (
      <p class="text-muted">
        <span class="font-display text-xl font-bold text-ink">{formatCents(totalRaised, lang)}</span>{' '}
        {de ? 'bisher gesammelt' : 'raised so far'}
      </p>
    )}
  </div>
  <div class="mt-8">
    <CampaignList lang={lang} campaigns={campaigns} />
  </div>
</section>

<!-- Approach split (photo + text) -->
<section class="bg-sand">
  <div class="container-page py-16 sm:py-20 lg:py-24 grid gap-8 lg:gap-12 lg:grid-cols-2 lg:items-center">
    <div class="relative overflow-clip rounded-[10px] shadow-sm">
      <Image
        src={motherChild}
        alt={de ? 'Eine Mutter hält ihr Kind auf dem Arm.' : 'A mother holding her child.'}
        widths={[480, 720, 960]}
        sizes="(min-width:1024px) 40vw, 100vw"
        class="w-full h-full object-cover aspect-[4/5] sm:aspect-[3/2] lg:aspect-[4/5]"
        loading="lazy"
      />
    </div>
    <div>
      <p class="eyebrow">{de ? 'Unser Ansatz' : 'Our approach'}</p>
      <h2 class="text-3xl sm:text-4xl font-bold">{de ? 'So arbeiten wir' : 'How we work'}</h2>
      <p class="mt-5 font-display text-2xl sm:text-3xl font-medium leading-snug">
        {de
          ? '„Nur weil ein Mensch an einem bestimmten Ort geboren wurde, sollte er nicht an Hunger sterben."'
          : '“No one should die of hunger simply because of where they were born.”'}
      </p>
      <p class="mt-5 text-lg text-muted">
        {de
          ? 'Christlich motiviert, ehrenamtlich getragen und projektbezogen – mit offener Abrechnung. Als gemeinnütziger Verein stellen wir sicher, dass jede Spende unmittelbar ankommt.'
          : 'Christian-motivated, volunteer-run and project-based — with open accounting. As a non-profit, we make sure every donation arrives directly.'}
      </p>
      <p class="mt-6">
        <a href={localizePath('/was-wir-tun', lang)} class="font-semibold underline decoration-gold underline-offset-4 hover:text-gold-700">
          {de ? 'Warum wir uns auf Afrika und den Sudan konzentrieren' : 'Why we focus on Africa and Sudan'} →
        </a>
      </p>
    </div>
  </div>
</section>

<!-- Closing CTA over photo -->
<section class="relative isolate overflow-clip bg-ink text-white">
  <Image
    src={sudanSlums}
    alt=""
    widths={[640, 960, 1280, 1920, 2448]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_60%]"
    loading="lazy"
  />
  <div class="absolute inset-0 -z-10" style="background:rgba(20,17,12,.72)"></div>
  <div class="container-page py-20 lg:py-28 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white">
      {de ? 'Werde Teil davon.' : 'Be part of it.'}
    </h2>
    <p class="mt-3 text-white/85 max-w-xl mx-auto">
      {de
        ? 'Mit deiner Spende oder deiner Mitgliedschaft veränderst du ein Leben.'
        : 'With your donation or your membership, you change a life.'}
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a class="btn" href={localizePath('/spenden', lang)}>{t('nav.donate')}</a>
      <a class="btn btn-on-dark" href={localizePath('/mitglied-werden', lang)}>{t('nav.join')}</a>
    </div>
  </div>
</section>
