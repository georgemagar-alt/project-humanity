---
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const all = (
  await getCollection('events', (e) => e.data.lang === lang && !e.data.draft)
).sort((a, b) => a.data.start.getTime() - b.data.start.getTime());

const now = Date.now();
const upcoming = all.filter((e) => (e.data.end ?? e.data.start).getTime() >= now);
const past = all.filter((e) => (e.data.end ?? e.data.start).getTime() < now).reverse();

const fmt = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', {
  dateStyle: 'full',
  timeStyle: 'short',
});
---

<div class="container-page py-16 lg:py-20">
  <p class="eyebrow">{t('nav.events')}</p>
  <h1 class="text-4xl sm:text-5xl font-bold">{t('nav.events')}</h1>

  <h2 class="mt-12 text-2xl font-bold">{t('events.upcoming')}</h2>
  {
    upcoming.length === 0 ? (
      <p class="mt-4 text-muted">{t('events.empty')}</p>
    ) : (
      <ul class="mt-6 grid gap-5 sm:grid-cols-2">
        {upcoming.map((ev) => (
          <li>
            <article class="card h-full p-6 border-l-4 border-l-gold">
              <time datetime={ev.data.start.toISOString()} class="text-sm font-semibold text-muted">
                {fmt.format(ev.data.start)}
              </time>
              <h3 class="mt-1 font-display text-xl font-bold">{ev.data.title}</h3>
              {ev.data.location && <p class="mt-1 font-semibold">{ev.data.location}</p>}
              {ev.data.summary && <p class="mt-2 text-muted">{ev.data.summary}</p>}
            </article>
          </li>
        ))}
      </ul>
    )
  }

  {
    past.length > 0 && (
      <>
        <h2 class="mt-14 text-2xl font-bold">{t('events.past')}</h2>
        <ul class="mt-6 grid gap-5 sm:grid-cols-2">
          {past.map((ev) => (
            <li>
              <article class="card h-full p-6 opacity-80">
                <time datetime={ev.data.start.toISOString()} class="text-sm font-semibold text-muted">
                  {fmt.format(ev.data.start)}
                </time>
                <h3 class="mt-1 font-display text-lg font-bold">{ev.data.title}</h3>
                {ev.data.location && <p class="mt-1 text-muted">{ev.data.location}</p>}
              </article>
            </li>
          ))}
        </ul>
      </>
    )
  }
</div>
