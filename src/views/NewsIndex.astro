---
import { getCollection } from 'astro:content';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (
  await getCollection('news', (e) => e.data.lang === lang && !e.data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const stripPrefix = (id: string) => id.replace(/^(de|en)\//, '');
const dateFmt = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { dateStyle: 'long' });
---

<div class="container-page py-16 lg:py-20">
  <p class="eyebrow">{t('nav.news')}</p>
  <h1 class="text-4xl sm:text-5xl font-bold">{t('nav.news')}</h1>

  {
    posts.length === 0 ? (
      <p class="mt-8 text-muted">{t('news.empty')}</p>
    ) : (
      <ul class="mt-10 grid gap-5 sm:grid-cols-2">
        {posts.map((post) => {
          const href = localizePath(`/aktuelles/${stripPrefix(post.id)}`, lang);
          return (
            <li>
              <article class="card h-full p-6 flex flex-col">
                <time datetime={post.data.date.toISOString()} class="text-sm font-semibold text-muted">
                  {dateFmt.format(post.data.date)}
                </time>
                <h2 class="mt-1.5 font-display text-xl font-bold">
                  <a href={href} class="hover:text-gold-700">{post.data.title}</a>
                </h2>
                {post.data.summary && <p class="mt-2 text-muted flex-1">{post.data.summary}</p>}
                <a href={href} class="mt-4 font-semibold text-gold-700 hover:underline">
                  {t('news.readMore')} →
                </a>
              </article>
            </li>
          );
        })}
      </ul>
    )
  }
</div>
