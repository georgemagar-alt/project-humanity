---
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'news'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { dateStyle: 'long' });

const origin = Astro.site ?? new URL(Astro.url.origin);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.date.toISOString(),
  inLanguage: lang,
  mainEntityOfPage: new URL(Astro.url.pathname, origin).toString(),
  author: { '@type': 'Organization', name: 'Project Humanity e.V.', url: origin.toString() },
  publisher: {
    '@type': 'Organization',
    name: 'Project Humanity e.V.',
    logo: { '@type': 'ImageObject', url: new URL('/logo.svg', origin).toString() },
  },
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />

<div class="container-page py-16 lg:py-20">
  <article class="prose-page">
    <p class="mb-6">
      <a href={localizePath('/aktuelles', lang)} class="font-semibold text-gold-700 hover:underline">
        ← {t('nav.news')}
      </a>
    </p>
    <time datetime={entry.data.date.toISOString()} class="text-sm font-semibold text-muted">
      {fmt.format(entry.data.date)}
    </time>
    <h1 class="mt-1.5 text-4xl sm:text-5xl font-bold mb-6">{entry.data.title}</h1>
    <Content />
  </article>
</div>
