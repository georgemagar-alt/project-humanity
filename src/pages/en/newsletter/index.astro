---
export const prerender = false;
import Base from '../../../layouts/BaseLayout.astro';
import Newsletter from '../../../views/Newsletter.astro';
Astro.response.headers.set('cache-control', 'public, max-age=300');
const lang = 'en' as const;
---

<Base
  lang={lang}
  title="Newsletter"
  description="The weekly newsletter of Project Humanity e.V.: honest, personal insights into our aid work in Sudan and Africa."
>
  <Newsletter lang={lang} />
</Base>
