---
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const cols: { heading: string; links: { label: string; path: string }[] }[] = [
  {
    heading: lang === 'de' ? 'Verein' : 'Association',
    links: [
      { label: t('nav.work'), path: '/was-wir-tun' },
      { label: t('nav.about'), path: '/wer-wir-sind' },
      { label: t('nav.events'), path: '/termine' },
    ],
  },
  {
    heading: lang === 'de' ? 'Mitmachen' : 'Get involved',
    links: [
      { label: t('nav.donate'), path: '/spenden' },
      { label: t('nav.join'), path: '/mitglied-werden' },
      { label: t('nav.newsletter'), path: '/newsletter' },
      { label: t('nav.faq'), path: '/faq' },
      { label: t('nav.contact'), path: '/kontakt' },
    ],
  },
  {
    heading: lang === 'de' ? 'Rechtliches' : 'Legal',
    links: [
      { label: t('nav.imprint'), path: '/impressum' },
      { label: t('nav.privacy'), path: '/datenschutz' },
    ],
  },
];
const linkCls = 'text-white/70 no-underline hover:text-gold transition-colors';
---

<footer class="bg-ink text-white/70">
  <div class="container-page py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <img src="/logo-white.svg" alt="Project Humanity e.V." width="170" height="133" class="h-16 w-auto" />
      <p class="mt-4 text-sm text-white/60 max-w-xs">
        {lang === 'de'
          ? 'Gemeinnütziger, rein ehrenamtlicher Verein – ohne Gehälter. So fließt fast jede Spende direkt in den Kampf gegen extreme Armut in Afrika.'
          : 'Non-profit, entirely volunteer-run — no salaries. So almost every donation goes directly to fighting extreme poverty in Africa.'}
      </p>
      <div class="mt-5 flex items-center gap-4">
        <a
          href="https://www.instagram.com/project_humanity_/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={lang === 'de' ? 'Project Humanity auf Instagram' : 'Project Humanity on Instagram'}
          class="text-white/70 hover:text-gold transition-colors"
        >
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/Project.Humanity.eV"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={lang === 'de' ? 'Project Humanity auf Facebook' : 'Project Humanity on Facebook'}
          class="text-white/70 hover:text-gold transition-colors"
        >
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
      </div>
    </div>

    {cols.map((col) => (
      <nav aria-label={col.heading}>
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-white mb-3">
          {col.heading}
        </h2>
        <ul class="space-y-2 text-sm">
          {col.links.map((l) => (
            <li><a href={localizePath(l.path, lang)} class={linkCls}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-10 grid gap-6 lg:grid-cols-2 lg:items-start">
      <div>
        <h2 class="font-display text-lg font-bold text-white">
          {lang === 'de' ? 'Einmal pro Woche Post von uns' : 'A letter from us, once a week'}
        </h2>
        <p class="mt-2 text-sm text-white/60 max-w-md">
          {lang === 'de'
            ? 'Ehrliche, persönliche Einblicke in unsere Arbeit im Sudan und in Afrika – direkt in dein Postfach.'
            : 'Honest, personal insights into our work in Sudan and Africa – straight to your inbox.'}
        </p>
      </div>
      <NewsletterForm lang={lang} variant="dark" />
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-6 text-sm text-white/50">
      © {year} Project Humanity e.V. — {t('footer.rights')}
    </div>
  </div>
</footer>
