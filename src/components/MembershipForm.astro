---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = {
  sending: t('join.sending'),
  success: t('join.success'),
  error: t('join.error'),
};
const label = 'grid gap-1.5 font-semibold';
const de = lang === 'de';
// Keys must match INTEREST_LABELS in /api/membership.
const interests = de
  ? [
      ['events', 'Bei Events'],
      ['fahrten', 'Fahrten'],
      ['medien', 'Fotos, Videos & Social Media'],
      ['texte', 'Texte, Übersetzung & Design'],
    ]
  : [
      ['events', 'At events'],
      ['fahrten', 'Driving'],
      ['medien', 'Photos, videos & social media'],
      ['texte', 'Writing, translation & design'],
    ];
---

<form class="grid gap-5 max-w-xl" id="join-form" novalidate>
  <input type="hidden" name="locale" value={lang} />

  <label class={label}>
    {t('join.name')}
    <input type="text" name="name" required autocomplete="name" class="field" />
  </label>
  <label class={label}>
    {t('join.email')}
    <input type="email" name="email" required autocomplete="email" class="field" />
  </label>
  <label class={label}>
    {t('join.phone')}
    <input type="tel" name="phone" autocomplete="tel" class="field" />
  </label>
  <fieldset class="border-0 p-0 m-0">
    <legend class="font-semibold mb-2">
      {de ? 'Wobei würdest du gern helfen? (optional)' : 'Where would you like to help? (optional)'}
    </legend>
    <div class="grid gap-2">
      {interests.map(([value, text]) => (
        <label class="flex items-center gap-2.5 font-medium cursor-pointer">
          <input type="checkbox" name="interests" value={value} class="w-5 h-5 accent-gold-700" />
          {text}
        </label>
      ))}
    </div>
  </fieldset>
  <label class={label}>
    {t('join.message')}
    <textarea name="message" rows="4" class="field"></textarea>
  </label>

  <div class="hp" aria-hidden="true">
    <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <button type="submit" class="btn justify-self-start" id="join-submit">{t('join.submit')}</button>
  <p
    class="m-0 min-h-[1.2em] font-semibold data-[kind=error]:text-red-700 data-[kind=success]:text-gold-700"
    id="join-status"
    role="status"
    aria-live="polite"
  ></p>
</form>

<script type="application/json" id="join-strings" is:inline set:html={JSON.stringify(strings)} />

<script>
  const form = document.getElementById('join-form') as HTMLFormElement | null;
  if (form) {
    const cfg = JSON.parse(
      document.getElementById('join-strings')?.textContent || '{}',
    ) as Record<string, string>;
    const btn = document.getElementById('join-submit') as HTMLButtonElement;
    const status = document.getElementById('join-status') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.removeAttribute('data-kind');
      status.textContent = cfg.sending;
      btn.disabled = true;

      const data = new FormData(form);
      const payload = { ...Object.fromEntries(data.entries()), interests: data.getAll('interests') };
      try {
        const res = await fetch('/api/membership', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.dataset.kind = 'success';
        status.textContent = cfg.success;
      } catch {
        status.dataset.kind = 'error';
        status.textContent = cfg.error;
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
