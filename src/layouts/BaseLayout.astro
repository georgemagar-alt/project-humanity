---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, swapLangPath, localizePath, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** Optional per-page social share image (absolute path from site root). */
  image?: string;
  /** Keep this page out of search engines (e.g. confirmation pages). */
  noindex?: boolean;
}
const { title, description, lang, image, noindex } = Astro.props;
const t = useTranslations(lang);
const fullTitle = `${title} – ${t('site.name')}`;

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).toString();
const altDe = new URL(swapLangPath(Astro.url.pathname, 'de'), origin).toString();
const altEn = new URL(swapLangPath(Astro.url.pathname, 'en'), origin).toString();
const ogImage = new URL(image ?? '/og-image.jpg', origin).toString();

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  '@id': new URL('/#organization', origin).toString(),
  name: 'Project Humanity e.V.',
  alternateName: 'Project Humanity',
  url: origin.toString(),
  logo: new URL('/logo.svg', origin).toString(),
  image: ogImage,
  sameAs: [
    'https://www.instagram.com/project_humanity_/',
    'https://www.facebook.com/Project.Humanity.eV',
  ],
  email: 'info@project-humanity.org',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Langstrasse 40',
    postalCode: '63486',
    addressLocality: 'Bruchköbel',
    addressCountry: 'DE',
  },
  areaServed: ['Sudan', 'Afrika'],
  foundingDate: '2015-12',
  // Vereinsregister entry (see Impressum).
  identifier: { '@type': 'PropertyValue', propertyID: 'Vereinsregister Amtsgericht Hanau', value: 'VR 32120' },
  knowsAbout:
    lang === 'de'
      ? ['Humanitäre Hilfe', 'Sudan', 'Armutsbekämpfung', 'Ehrenamt']
      : ['Humanitarian aid', 'Sudan', 'Poverty relief', 'Volunteering'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: lang === 'de' ? 'Allgemeine Anfragen' : 'General enquiries',
    email: 'info@project-humanity.org',
    url: new URL(localizePath('/kontakt', lang), origin).toString(),
    availableLanguage: ['de', 'en'],
  },
  description:
    lang === 'de'
      ? 'Gemeinnütziger Verein, der den ärmsten Menschen in den Slums Afrikas Nahrung, Kleidung, Schulmaterial und medizinische Versorgung bereitstellt.'
      : 'Non-profit association providing food, clothing, school supplies and healthcare to the poorest people in the slums of Africa.',
  potentialAction: {
    '@type': 'DonateAction',
    name: lang === 'de' ? 'Spenden' : 'Donate',
    target: new URL(localizePath('/spenden', lang), origin).toString(),
    recipient: { '@type': 'NGO', name: 'Project Humanity e.V.' },
  },
};

// Generic breadcrumb trail from the URL path (skipped on the home page).
const segs = Astro.url.pathname.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const isEn = segs[0] === 'en';
const pathSegs = isEn ? segs.slice(1) : segs;
const humanize = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
let breadcrumbLd: Record<string, unknown> | null = null;
if (pathSegs.length > 0) {
  const items = [
    { name: lang === 'de' ? 'Start' : 'Home', url: new URL(isEn ? '/en' : '/', origin).toString() },
  ];
  let acc = isEn ? '/en' : '';
  pathSegs.forEach((seg, i) => {
    acc += '/' + seg;
    const last = i === pathSegs.length - 1;
    items.push({ name: last ? title : humanize(seg), url: new URL(acc, origin).toString() });
  });
  breadcrumbLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((it, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: it.name,
      item: it.url,
    })),
  };
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f9ae1b" />
    <Font cssVariable="--ff-sans" preload />
    <Font cssVariable="--ff-display" preload />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={altDe} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altDe} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgLd)} />
    {breadcrumbLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <Nav lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
