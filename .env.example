# Copy this file to ".env" and fill in the values.
# Never commit the real ".env" file.

# --- Site ------------------------------------------------------------
PUBLIC_SITE_URL=https://your-domain.org

# --- PayPal --------------------------------------------------------
# Create an app at https://developer.paypal.com/dashboard/applications
# Use "sandbox" while testing, switch to "live" only when going public.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From Dashboard > Webhooks (the ID of the webhook you register for this site)
PAYPAL_WEBHOOK_ID=
# This value is exposed to the browser (needed to load the PayPal button SDK).
PUBLIC_PAYPAL_CLIENT_ID=

# --- Database (Turso) --------------------------------------------------
# Sign up at https://turso.tech , then:  turso db create humanity
# For LOCAL development you can instead point at a file:
#   TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# --- Email (Brevo) --------------------------------------------------
# API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
EMAIL_FROM=Project Humanity <spenden@your-domain.org>
MEMBERSHIP_NOTIFY_EMAIL=vorstand@your-domain.org

# --- Admin page ---------------------------------------------------
# Long random string. Used to log in at /admin.
ADMIN_TOKEN=change-me-to-a-long-random-string
